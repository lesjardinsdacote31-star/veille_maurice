# Copie ce fichier en .env (jamais commité) pour lancer la collecte en local.
# En production, ces valeurs vivent dans les secrets GitHub Actions, pas ici.

# Supabase : Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio : aistudio.google.com > Get API key
# ATTENTION : ne jamais activer la facturation sur ce projet Google, sous
# peine de perdre l'allocation gratuite au lieu de s'y ajouter.
GEMINI_API_KEY=
# Vérifie dans AI Studio le nom exact du modèle Flash actif sur le plan
# gratuit et son quota réel (peut changer avec le temps). Évite les alias
# "-latest" : au moins une fois (sept. 2026), un alias pointait vers un
# modèle preview au quota gratuit très réduit (20/jour). Les modèles
# complets ("gemini-3.6-flash" etc.) ont eux aussi été mesurés à 20/jour —
# nettement insuffisant pour 3 collectes/jour. Les variantes "Lite" ont
# normalement un quota bien plus généreux, à vérifier dans AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

# Apify : console.apify.com > Settings > Integrations > API token
# 5$ de crédit gratuit renouvelé chaque mois sur le plan Free.
APIFY_API_TOKEN=

# Notifications Web Push : python -m scripts.generer_cles_vapid (une seule
# fois — regénérer invaliderait tous les abonnements déjà enregistrés).
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
VAPID_CONTACT_EMAIL=
